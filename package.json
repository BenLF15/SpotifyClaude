{
  "name": "spotify-stats-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Persönliches Spotify-Statistik-Dashboard (Express + Postgres), deploybar auf Render.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node scripts/migrate.js",
    "cron": "node scripts/cron.js",
    "snapshot": "node scripts/cron.js --snapshot",
    "import": "node scripts/import-history.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "chart.js": "^4.6.1",
    "compression": "^1.7.4",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
