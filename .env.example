# Kopiere diese Datei nach .env (nur für lokale Entwicklung – .env wird nicht committet).
# Auf Render trägst du dieselben Werte unter "Environment" ein.

# ---- Pflicht ----------------------------------------------------------------
# Postgres-Verbindung (auf Render: "Internal Database URL" der Datenbank)
DATABASE_URL=postgres://user:pass@localhost:5432/spotify
# Spotify-App (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Optional ---------------------------------------------------------------
# Spotify-User-IDs mit Admin-Rechten (Tab „Nutzer“), Komma-getrennt.
# Ohne Angabe wird der erste Nutzer, der sich anmeldet, Admin.
# ADMIN_SPOTIFY_IDS=
# Spotify-Anzeigenamen, die beim Login automatisch Admin werden (Standard: Nebs; leer = aus)
# ADMIN_SPOTIFY_NAMES=Nebs
# Standard auf Render: ${RENDER_EXTERNAL_URL}/auth/callback, lokal: http://127.0.0.1:PORT/auth/callback
# SPOTIFY_REDIRECT_URI=
# Eigener Cookie-Schlüssel (sonst aus dem Client-Secret abgeleitet)
# SESSION_SECRET=
TIMEZONE=Europe/Berlin
PORT=3000
# Interner Zeitplan (true/false) und Intervall in Minuten
# INTERNAL_SCHEDULER=true
# SYNC_INTERVAL_MINUTES=30
# Selbst-Ping alle 10 Min., damit ein Render-Free-Service nicht einschläft (Standard: an, wenn auf Render)
# KEEP_ALIVE=true
# Erlaubt externen Trigger über /cron/run?key=...
# CRON_SECRET=
# Wie viele Tracks/Künstler pro Lauf mit Covern/Genres angereichert werden
# ENRICH_LIMIT=150
# Importierte Plays unter dieser Dauer werden ignoriert (Spotify zählt ab 30 s)
# MIN_PLAY_MS=30000
