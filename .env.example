# Kopiere diese Datei nach .env (nur für lokale Entwicklung – .env wird nicht committet).

# Postgres-Verbindung (lokal oder die "External Database URL" von Render)
DATABASE_URL=postgres://user:pass@localhost:5432/spotify

# Spotify-App (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Muss exakt so in der Spotify-App als Redirect URI eingetragen sein.
# Auf Render optional: Standard ist ${RENDER_EXTERNAL_URL}/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Zugangsschutz fürs Dashboard
APP_PASSWORD=change-me
# Langer Zufallswert zum Signieren der Session-Cookies (z. B. `openssl rand -hex 32`)
SESSION_SECRET=

# Optional
TIMEZONE=Europe/Berlin
PORT=3000
# Wie viele Tracks/Künstler pro Cron-Lauf mit Covern/Genres angereichert werden
ENRICH_LIMIT=150
# Plays aus dem History-Import unter dieser Dauer werden ignoriert (Spotify zählt ab 30 s)
MIN_PLAY_MS=30000
